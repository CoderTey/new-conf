{
  "layer": "top",
  "output": "eDP-1",

  "modules-left": ["sway/workspaces", "sway/mode"],
  "modules-center": ["clock"],
  "modules-right": ["cpu", "memory"],

  "clock": {
    "format-alt": "{:%a, %d. %b  %H:%M}"
  },

  "cpu": {
    "format": "CPU: {usage}%",
    "interval": 1
  },

  "memory": {
    "format": " RAM: {percentage}%",
    "interval": 1
  }
}
